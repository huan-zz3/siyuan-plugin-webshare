{
  "name": "siyuan-plugin-webshare",
  "version": "0.1.0",
  "type": "module",
  "description": "【思源笔记公网分享插件】思源笔记插件，支持将笔记内容分享到公网，生成可访问的链接。免费使用，可自部署。",
  "repository": "https://github.com/huan-zz3/siyuan-plugin-webshare",
  "homepage": "https://github.com/huan-zz3/siyuan-plugin-webshare",
  "author": "幻酌",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "run-p dev:app dev:kernel",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "check": "run-s check:types check:svelte",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "node ./scripts/clean.js",
    "build": "run-s clean build:app build:kernel",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "server:dev": "pnpm --dir server dev",
    "server:check": "pnpm --dir server check",
    "server:test": "pnpm --dir server test",
    "server:build": "pnpm --dir server build",
    "server:start": "pnpm --dir server start",
    "check:all": "pnpm run check && pnpm run server:check && pnpm run server:test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/livereload": "^0.9.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.1",
    "livereload": "^0.9.3",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "sass": "^1.103.1",
    "siyuan": "1.2.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
