{
  "name": "@siyuan-publisher/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static hosting server for SiYuan Publisher artifacts.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
